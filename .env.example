# Copy to .env before running docker compose. Only used by the *-auth
# sidecar (Keycloak OAuth); the MCP server's own credentials live in
# ynab.env (see ynab.env.example).

# Keycloak realm the auth sidecar validates bearer tokens against.
OIDC_ISSUER_URL=https://keycloak.example.com/realms/your-realm

# Leave unset unless you want to restrict tokens to a specific Keycloak
# client (azp claim). Unset means any client in the realm is accepted.
JWT_REQUIRED_AZP=

# Optional overrides (defaults shown as comments):
# YNAB_MCP_BIND_ADDR=0.0.0.0
# YNAB_MCP_PORT=5090
# YNAB_MCP_PUBLIC_URL=
# YNAB_MCP_RESOURCE_URL=
# YNAB_JWT_AUDIENCE=
